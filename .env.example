# ==============================================================================
# LetStyle Environment Configuration
# ALL secrets and provider credentials are strictly SERVER-SIDE ONLY.
# NEVER add NEXT_PUBLIC_ prefixes to API keys.
# ==============================================================================

# Database Configuration (Vercel Postgres, Neon, Supabase, or SQLite)
# For production on Vercel, attach Vercel Postgres or set your Neon/Supabase PostgreSQL connection string:
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require
# If left empty in local development, LetStyle automatically falls back to persistent local SQLite (letstyle.db).
DATABASE_URL=
# Optional override for local SQLite file path (defaults to ./letstyle.db)
# SQLITE_DB_PATH=./letstyle.db

# Free Credits Allowance Configuration
# Initial free credit grant awarded once upon verified registration (default: 20)
INITIAL_FREE_CREDITS=20

# Server-side Configurable Credit Costs per Paid AI Operation
CREDIT_COST_RECOMMENDATIONS=2
CREDIT_COST_GENERATE_IMAGE=3
CREDIT_COST_REFINE_IMAGE=3
CREDIT_COST_TRY_ON=3
CREDIT_COST_AVATAR_CREATE=3
CREDIT_COST_SEARCH_DRESSES=1
CREDIT_COST_SEARCH_DRESSES_RESEARCH=1
CREDIT_COST_SEARCH_DRESSES_REFINE=1
CREDIT_COST_PRODUCT_RECOMMENDATIONS=1
CREDIT_COST_ANALYZE_PHOTO=1

# OpenAI API Key (Required for AI recommendations, photo analysis & look visualization)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration (Optional server overrides)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Tavily API Key (Required for live product search and dress discovery)
TAVILY_API_KEY=your_tavily_api_key_here

# Search Provider Selection: "tavily" (default) or "openai"
SEARCH_PROVIDER=tavily

# Virtual Try-On Provider Selection: "openai" (default) or "fashn"
VTO_PROVIDER=openai
# FASHN_API_KEY=your_fashn_api_key_here

# ==============================================================================
# Background generation + Web Push notifications
# ==============================================================================
# Generation runs as a server-side job (src/lib/generation-jobs.ts) so it keeps
# going when the user switches apps or locks their phone, then notifies them.
# Job state lives in the database above. In production on serverless hosts this
# MUST be PostgreSQL: the SQLite /tmp fallback is per-instance and not shared.

# VAPID keys for Web Push — generate once with: npx web-push generate-vapid-keys
# Server-side only. The public key is served to browsers at /api/push/vapid-public-key.
# Leave unset to disable push (generation still runs in the background; users
# just won't be notified when the app is closed).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (mailto: or https: URL)
VAPID_SUBJECT=mailto:support@letstyle.app

# Protects /api/generation/jobs/run (serverless hand-off + stalled-job sweep).
# Vercel Cron (vercel.json, every 5 min) sends it as "Authorization: Bearer $CRON_SECRET".
# Note: Vercel Hobby only allows daily crons and rejects a deploy with this schedule.
CRON_SECRET=
# Public base URL used for the serverless hand-off request (falls back to
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL on Vercel). Never derived from request headers.
# APP_BASE_URL=https://letstyle.example.com

# Optional tuning
# Parallel image renders per job (1-5, default 5 = all looks in one wave).
# Lower it if your OpenAI image rate limit is tight (429s are retried by the SDK).
# GENERATION_IMAGE_CONCURRENCY=5
# Total ms of provider work per runner invocation. A step only starts if its
# whole timeout still fits, then the runner saves progress and hands off.
# Default: 270000 on Vercel (routes allow 300s), unlimited elsewhere.
# GENERATION_JOB_TIME_BUDGET_MS=270000
# Hard limit per attempt; every OpenAI call in the attempt is aborted after it.
# GENERATION_RECOMMENDATIONS_TIMEOUT_MS=120000
# GENERATION_IMAGE_TIMEOUT_MS=120000
