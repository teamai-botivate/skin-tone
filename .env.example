# ==============================================================================
# SkinTune Environment Configuration
# ALL secrets and provider credentials are strictly SERVER-SIDE ONLY.
# NEVER add NEXT_PUBLIC_ prefixes to API keys.
# ==============================================================================

# OpenAI API Key (Required for AI recommendations, photo analysis & look visualization)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Configuration (Optional server overrides)
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Tavily API Key (Required for live product search and dress discovery)
TAVILY_API_KEY=your_tavily_api_key_here

# Search Provider Selection: "tavily" (default) or "openai"
SEARCH_PROVIDER=tavily

# Virtual Try-On Provider Selection: "openai" (default) or "fashn"
VTO_PROVIDER=openai
# FASHN_API_KEY=your_fashn_api_key_here
